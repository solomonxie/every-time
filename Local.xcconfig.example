// Copy to Local.xcconfig (gitignored) and set your Apple Developer Team ID and bundle id.
// developer.apple.com → Account → Membership details → Team ID.
DEVELOPMENT_TEAM = REPLACE_WITH_YOUR_TEAM_ID
// Also used for the widget ($(APP_BUNDLE_ID).widget), the app group (group.$(APP_BUNDLE_ID))
// and the iCloud container (iCloud.$(APP_BUNDLE_ID)).
APP_BUNDLE_ID = com.example.everytime
