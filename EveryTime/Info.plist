<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>group.$(APP_BUNDLE_ID)</string>
	<key>AppStoreRegion</key>
	<string>$(STORE)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Every Time</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ICloudContainerIdentifier</key>
	<string>iCloud.$(APP_BUNDLE_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Wakes you at the end of a nap, even in silent mode.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Finds events in your calendar to mark as important and adds lunar events.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Adds your lunar events to the iPhone Calendar.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Shows your past nights of sleep from the Health app.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Every Time never writes to the Health app. It only reads your sleep.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.$(APP_BUNDLE_ID)</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Every Time</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
